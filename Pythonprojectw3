#date and time
from datetime import datetime

#converts weight from pounds to kilograms
def convertData(weight):
    converted = weight / 2.205
    return converted

#gets the user's date and weight and converts the weight
def getInput():
    entries = int(input("How many entries are you inputting? "))

    for i in range(entries):
        date = input("Enter a date: ")
        weight = int(input("Enter the weight in pounds for the inputted date: "))

        #calls convertData(weight) using pounds and returns kilograms
        converted = convertData(weight)

        print("The following was saved at", datetime.now(), ":")
        print(date, weight, converted, sep=",")

